<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>User Dashboard & Email Generator</title>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Root variables */
      :root {
        --primary: #6a11cb;
        --danger: #e53935;
        --gray-bg: #f4f6f9;
        --card-bg: #fff;
        --border-radius: 16px;
        --shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        --transition: 0.2s;

        --text-color: #333;
        --background-color: var(--gray-bg);
        --card-text-color: #000;
        --input-bg: #fafbfc;
        --input-border: #ccc;
        --select-placeholder-color: #888;
      }

      /* Dark mode variables */
      body.dark-mode {
        --primary: #9c27b0;
        --danger: #ef5350;
        --gray-bg: #121212;
        --card-bg: #1e1e1e;
        --text-color: #eee;
        --background-color: #121212;
        --card-text-color: #eee;
        --shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
        --input-bg: #2a2a2a;
        --input-border: #555;
        --toast-bg: #204d8b;
        --toast-text: #fff;
        --select-placeholder-color: #bbb;
      }

      /* Apply colors */
      html,
      body {
        height: 100%;
        margin: 0;
        padding: 0;
        font-family: 'Public Sans', sans-serif;
        background: var(--background-color);
        color: var(--text-color);
        transition: background var(--transition), color var(--transition);
        height: 100vh;
        overflow: hidden;
      }

      body {
        display: flex;
        flex-direction: column;
      }

      /* Navbar */
      .navbar {
        position: fixed;
        height: 52px;
        top: 0;
        left: 0;
        right: 0;

        background: var(--primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        font-weight: 600;
        font-size: 0.95rem;
        z-index: 10001;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        user-select: none;
      }
      .navbar-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .navbar-left .navbar-brand {
        user-select: none;
      }
      .navbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 500;
      }

      /* Toggle Switch */
      .switch {
        position: relative;
        display: inline-block;
        width: 36px;
        height: 18px;
      }
      .switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }
      .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: 0.4s;
        border-radius: 18px;
      }
      .slider:before {
        position: absolute;
        content: '';
        height: 14px;
        width: 14px;
        left: 2px;
        bottom: 2px;
        background-color: white;
        transition: 0.4s;
        border-radius: 50%;
      }
      input:checked + .slider {
        background-color: #4e0899;
      }
      input:checked + .slider:before {
        transform: translateX(18px);
      }

      /* Layout: Sidebar + Main Content */
      .layout {
        display: flex;
        height: calc(100vh - 30px); /* full height minus navbar */
        margin-top: 30px; /* below navbar */
        overflow: hidden;
      }

      /* Sidebar */
      .sidebar {
        width: 240px;
        background: var(--card-bg);
        box-shadow: var(--shadow);
        border-radius: 0 0 var(--border-radius) 0;
        display: flex;
        flex-direction: column;
        padding-top: 24px;
        user-select: none;
        transition: background var(--transition), color var(--transition);
        overflow-y: auto;
        position: relative;
        z-index: 1000;
      }
      body.dark-mode .sidebar {
        background: var(--card-bg);
        color: var(--card-text-color);
      }
      .sidebar ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .sidebar li {
        margin: 0;
      }
      .sidebar button {
        width: 100%;
        padding: 14px 24px;
        border: none;
        background: none;
        text-align: left;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-color);
        cursor: pointer;
        border-left: 4px solid transparent;
        transition: background var(--transition), color var(--transition),
          border-color var(--transition);
      }
      .sidebar button:hover,
      .sidebar button:focus {
        background: var(--gray-bg);
        outline: none;
      }
      body.dark-mode .sidebar button:hover,
      body.dark-mode .sidebar button:focus {
        background: #2a2a2a;
      }
      .sidebar button.active {
        border-left-color: var(--primary);
        background: var(--gray-bg);
        color: var(--primary);
        font-weight: 700;
      }
      body.dark-mode .sidebar button.active {
        background: #2a2a2a;
        color: var(--primary);
      }

      /* Sidebar toggle button for small screens */
      #sidebarToggle {
        display: none;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        color: white;
        cursor: pointer;
        user-select: none;
      }

      /* Main Content */
      .main-content {
        flex: 1;
        background: var(--background-color);
        padding: 24px 32px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 32px;
        transition: margin-left 0.3s ease;
        box-sizing: border-box;
        max-width: 100%;
      }

      /* Cards and Sections */
      .card {
        background: var(--card-bg);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
        padding: 32px 24px;
        display: flex;
        flex-direction: column;
        gap: 24px;
        min-width: 0;
        color: var(--card-text-color);
        transition: background var(--transition), color var(--transition),
          box-shadow var(--transition);
        box-sizing: border-box;
        max-width: 100%;
      }

      /* Fix input overflow */
      input,
      select,
      textarea {
        max-width: 100%;
        box-sizing: border-box;
      }

      /* Hide all sections by default */
      .section {
        display: none;
      }
      /* Show active section */
      .section.active {
        display: block;
      }

      /* Info card styles */
      .info {
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .avatar {
        width: 72px;
        height: 72px;
        background: #ccc url('https://i.pravatar.cc/72') center/cover;
        border-radius: 50%;
        border: 3px solid var(--primary);
      }
      .info-details h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--card-text-color);
      }
      .info-details p {
        margin: 4px 0 0 0;
        color: #555;
        font-size: 1rem;
      }
      .status {
        display: inline-block;
        margin-top: 8px;
        background: var(--primary);
        color: #fff;
        padding: 4px 14px;
        border-radius: 14px;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.5px;
      }
      .actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }
      .btn {
        flex: 1 1;
        padding: 12px 0;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: background var(--transition), color var(--transition),
          box-shadow var(--transition);
        font-size: 1rem;
        outline: none;
        box-sizing: border-box;
      }
      .btn-primary {
        background: var(--primary);
        color: #fff;
      }
      .btn-primary:hover,
      .btn-primary:focus {
        background: #4e0899;
        box-shadow: 0 2px 8px rgba(106, 17, 203, 0.08);
      }
      .btn-danger {
        background: var(--danger);
        color: #fff;
      }
      .btn-danger:hover,
      .btn-danger:focus {
        background: #b71c1c;
      }
      .btn-secondary {
        background: #555;
        color: #fff;
      }
      .btn-secondary:hover,
      .btn-secondary:focus {
        background: #333;
      }
      .btn-full {
        width: 100%;
      }
      .success-msg,
      .error-msg {
        margin-top: 12px;
        font-size: 1rem;
        font-weight: 500;
        display: none;
      }
      .success-msg {
        color: #219653;
      }
      .error-msg {
        color: var(--danger);
      }
      .form-group {
        margin-bottom: 18px;
        position: relative;
      }
      input,
      select,
      textarea {
        width: 100%;
        padding: 12px 14px;
        font-size: 1rem;
        border-radius: 8px;
        border: 1px solid var(--input-border);
        background: var(--input-bg);
        transition: border var(--transition), box-shadow var(--transition);
        outline: none;
        color: var(--text-color);
      }
      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 2px #e0d7f7;
      }
      textarea {
        min-height: 120px;
        resize: vertical;
        color: var(--text-color);
        background: var(--input-bg);
      }
      /* Fix for select placeholder color */
      select {
        color: var(--text-color);
      }
      select option[disabled][selected] {
        color: var(--select-placeholder-color);
      }
      .toggle-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        color: var(--primary);
        padding: 0;
      }
      .video-container {
        margin-top: 18px;
        display: none; /* Hidden by default, shown only in SMTP section */
      }
      .video-container.active {
        display: block;
      }
      .video-container label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        color: var(--card-text-color);
      }
      .video-container iframe {
        width: 100%;
        min-height: 220px;
        border-radius: 8px;
        border: none;
      }
      .hidden {
        display: none !important;
      }
      /* Email History */
      .email-history {
        margin-top: 10px;
        padding-top: 16px;
        border-top: 1px solid #eee;
      }
      .email-history h3 {
        margin: 0 0 10px 0;
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--card-text-color);
      }
      .history-list {
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 400px;
        overflow-y: auto;
      }
      .history-card {
        background: #f8f9fc;
        border-left: 4px solid var(--primary);
        padding: 12px 16px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        color: var(--text-color);
      }
      body.dark-mode .history-card {
        background: #2a2a2a;
        border-left-color: var(--primary);
        color: var(--card-text-color);
      }
      .history-card h4 {
        margin: 0 0 4px 0;
        font-size: 1rem;
        color: #333;
        font-weight: 600;
      }
      body.dark-mode .history-card h4 {
        color: var(--card-text-color);
      }
      .history-card p {
        margin: 2px 0;
        font-size: 0.95rem;
        color: #555;
      }
      body.dark-mode .history-card p {
        color: #ccc;
      }
      /* Modal */
      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.45);
        justify-content: center;
        align-items: center;
        z-index: 9999;
      }
      .modal-content {
        background: #fff;
        padding: 32px 24px;
        border-radius: var(--border-radius);
        width: 95vw;
        max-width: 400px;
        box-shadow: var(--shadow);
        color: var(--text-color);
      }
      body.dark-mode .modal-content {
        background: var(--card-bg);
        color: var(--card-text-color);
      }

      #cancelSMTPBtn {
        margin-top: 10px;
      }

      /* Responsive tweaks */
      @media (max-width: 600px) {
        /* Sidebar toggle button visible */
        #sidebarToggle {
          display: inline-block;
        }

        .layout {
          flex-direction: column;
          height: auto;
          margin-top: 30px;
        }

        .sidebar {
          position: fixed;
          top: 30px;
          left: 0;
          bottom: 0;
          width: 100%;
          max-width: 100%;
          background: var(--card-bg);
          box-shadow: var(--shadow);
          border-radius: 0 0 var(--border-radius) 0;
          transform: translateX(-100%);
          transition: transform 0.3s ease;
          z-index: 10000;
          overflow-y: auto;
        }
        .sidebar.open {
          transform: translateX(0);
        }

        body.dark-mode .sidebar {
          background: var(--card-bg);
          color: var(--card-text-color);
        }

        .sidebar ul {
          display: flex;
          flex-direction: column;
          padding: 0;
          margin: 0;
        }

        .sidebar button {
          padding: 14px 20px;
          font-size: 1rem;
        }

        .main-content {
          padding: 16px 16px 80px;
          height: calc(100vh - 30px);
          overflow-y: auto;
          margin-left: 0;
          transition: margin-left 0.3s ease;
          max-width: 100%;
        }

        /* When sidebar open, push main content */
        .sidebar.open ~ .main-content {
          margin-left: 0;
        }
      }

      @media (min-width: 601px) and (max-width: 900px) {
        /* Sidebar toggle button visible */
        #sidebarToggle {
          display: inline-block;
        }

        .layout {
          flex-direction: row;
          height: calc(100vh - 30px);
          margin-top: 30px;
        }

        .sidebar {
          position: fixed;
          top: 30px;
          left: 0;
          bottom: 0;
          width: 230px; /* fixed width for tablet */
          max-width: 230px;
          background: var(--card-bg);
          box-shadow: var(--shadow);
          border-radius: 0 0 var(--border-radius) 0;
          transform: translateX(-100%);
          transition: transform 0.3s ease;
          z-index: 10000;
          overflow-y: auto;
        }
        .sidebar.open {
          transform: translateX(0);
        }

        body.dark-mode .sidebar {
          background: var(--card-bg);
          color: var(--card-text-color);
        }

        .sidebar ul {
          display: flex;
          flex-direction: column;
          padding: 0;
          margin: 0;
        }

        .sidebar button {
          padding: 14px 20px;
          font-size: 1rem;
        }

        .main-content {
          padding: 16px 16px 80px;
          height: calc(100vh - 30px);
          overflow-y: auto;
          margin-left: 0;
          transition: margin-left 0.3s ease;
          max-width: 100%;
        }

        /* When sidebar open, push main content */
        .sidebar.open ~ .main-content {
          margin-left: 230px;
        }
      }

      @media (min-width: 901px) {
        #sidebarToggle {
          display: none;
        }

        .layout {
          flex-direction: row;
          height: calc(100vh - 30px);
          margin-top: 30px;
        }

        .sidebar {
          position: relative;
          width: 240px;
          max-width: 240px;
          transform: translateX(0);
          box-shadow: var(--shadow);
          border-radius: 0 0 var(--border-radius) 0;
          overflow-y: auto;
        }

        .main-content {
          padding: 24px 32px;
          margin-left: 240px;
          height: calc(100vh - 30px);
          overflow-y: auto;
          max-width: calc(100% - 240px);
        }
      }
    </style>
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar" role="banner">
      <div class="navbar-left">
        <button
          id="sidebarToggle"
          aria-label="Toggle sidebar menu"
          title="Toggle sidebar"
          aria-expanded="false"
          aria-controls="sidebarNav"
        >
          ☰
        </button>
        <span class="navbar-brand">User Dashboard</span>
      </div>
      <div class="navbar-right">
        <span id="navUserName">User</span>
        <label class="switch" title="Toggle dark mode">
          <input type="checkbox" id="modeToggle" />
          <span class="slider round"></span>
        </label>
      </div>
    </nav>

    <div class="layout">
      <!-- Sidebar -->
      <nav
        class="sidebar"
        aria-label="Sidebar navigation"
        id="sidebarNav"
        tabindex="-1"
      >
        <ul>
          <li>
            <button
              class="active"
              data-target="dashboardSection"
              type="button"
              id="dashboardBtn"
            >
              Dashboard
            </button>
          </li>
          <li>
            <button
              data-target="emailGeneratorSection"
              type="button"
              id="emailGeneratorBtn"
              style="display: none"
            >
              Email Generator
            </button>
          </li>
          <li>
            <button
              data-target="updatePasswordSection"
              type="button"
              id="updatePasswordBtnSidebar"
            >
              Update Password
            </button>
          </li>
          <li>
            <button
              data-target="smtpSetupSection"
              type="button"
              id="smtpSetupBtnSidebar"
            >
              Setup/Update SMTP
            </button>
          </li>
          <li>
            <button
              data-target="emailHistorySection"
              type="button"
              id="emailHistoryBtn"
              style="display: none"
            >
              Email History
            </button>
          </li>
          <li>
            <button id="logoutBtnSidebar" type="button" class="btn-danger">
              Logout
            </button>
          </li>
        </ul>
      </nav>

      <!-- Main content -->
      <main class="main-content" id="mainContent" tabindex="-1">
        <!-- Dashboard Section -->
        <section
          id="dashboardSection"
          class="section active"
          tabindex="0"
          aria-label="Dashboard"
        >
          <div class="card">
            <div class="info">
              <div class="avatar" aria-hidden="true"></div>
              <div class="info-details">
                <h2 id="userName">Loading...</h2>
                <p id="userEmail">user@example.com</p>
                <span class="status">Pro Member</span>
              </div>
            </div>
            <div class="actions">
              <button class="btn btn-primary" id="openPasswordModalSidebar">
                Update Password
              </button>
              <button class="btn btn-secondary" id="openSMTPModalSidebar">
                Setup/Update SMTP
              </button>
            </div>
            <p class="success-msg" id="passSuccess">
              Password updated successfully!
            </p>
            <p class="success-msg" id="smtpSuccess">SMTP credentials saved!</p>
            <div class="error-msg" id="smtpApiError"></div>
            <!-- NO video here as requested -->
          </div>
        </section>

        <!-- Email Generator Section -->
        <section
          id="emailGeneratorSection"
          class="section"
          tabindex="0"
          aria-label="Email Generator"
        >
          <div class="card">
            <h3>📧 Gemini Email Generator</h3>
            <div class="form-group">
              <input
                type="text"
                id="topic"
                placeholder="Enter topic for the email"
                autocomplete="off"
                aria-describedby="topicError"
              />
              <div class="error-msg" id="topicError" role="alert"></div>
            </div>
            <div class="form-group">
              <select
                id="emailTone"
                aria-label="Select email tone"
                aria-describedby="emailToneError"
              >
                <option value="" disabled selected>Select email tone</option>
                <option value="formal">Formal</option>
                <option value="informal">Informal</option>
                <option value="persuasive">Persuasive</option>
                <option value="friendly">Friendly</option>
              </select>
              <div class="error-msg" id="emailToneError" role="alert"></div>
            </div>
            <button
              class="btn btn-secondary btn-full"
              id="generateEmailBtn"
              type="button"
              onclick="generateEmail()"
            >
              Generate Email
            </button>
            <div class="form-group">
              <label for="toEmail">Receiver Address</label>
              <input
                type="email"
                id="toEmail"
                placeholder="Your email address"
                autocomplete="email"
                aria-describedby="toEmailError"
              />
              <div class="error-msg" id="toEmailError" role="alert"></div>
            </div>
            <div class="form-group">
              <label for="subject">Subject</label>
              <input
                type="text"
                id="subject"
                placeholder="Subject"
                autocomplete="off"
                aria-describedby="subjectError"
              />
              <div class="error-msg" id="subjectError" role="alert"></div>
            </div>
            <div class="form-group">
              <label for="emailContent">Generated Email</label>
              <textarea
                id="emailContent"
                rows="14"
                placeholder="Generated content."
              ></textarea>
            </div>
            <div class="form-group">
              <label for="attachments">Attachments (optional)</label>
              <input type="file" id="attachments" multiple />
            </div>
            <button
              class="btn btn-primary btn-full"
              id="sendEmailBtn"
              type="button"
              onclick="sendEmail()"
            >
              Send to My Email
            </button>
            <div id="sendError" class="error-msg" role="alert"></div>
            <div id="sendSuccess" class="success-msg"></div>
          </div>
        </section>

        <!-- Update Password Section -->
        <section
          id="updatePasswordSection"
          class="section"
          tabindex="0"
          aria-label="Update Password"
        >
          <div class="card">
            <h3>Update Password</h3>
            <div class="form-group">
              <input
                type="password"
                id="newPassword"
                minlength="6"
                autocomplete="new-password"
                placeholder="New password"
                aria-describedby="newPasswordError"
              />
              <button
                class="toggle-password"
                onclick="togglePassword('newPassword', this)"
                type="button"
                aria-label="Toggle password visibility"
              >
                👁
              </button>
              <div class="error-msg" id="newPasswordError" role="alert"></div>
            </div>
            <div class="form-group">
              <input
                type="password"
                id="confirmPassword"
                minlength="6"
                autocomplete="new-password"
                placeholder="Confirm password"
                aria-describedby="confirmPasswordError"
              />
              <button
                class="toggle-password"
                onclick="togglePassword('confirmPassword', this)"
                type="button"
                aria-label="Toggle password visibility"
              >
                👁
              </button>
              <div
                class="error-msg"
                id="confirmPasswordError"
                role="alert"
              ></div>
            </div>
            <div style="display: flex; gap: 10px">
              <button
                class="btn btn-secondary"
                id="cancelUpdatePasswordBtn"
                type="button"
              >
                Cancel
              </button>
              <button class="btn btn-primary" id="updatePasswordBtn" disabled>
                Update
              </button>
            </div>
            <p class="success-msg" id="passSuccessInline">
              Password updated successfully!
            </p>
          </div>
        </section>

        <!-- SMTP Setup Section -->
        <section
          id="smtpSetupSection"
          class="section"
          tabindex="0"
          aria-label="SMTP Setup"
        >
          <div class="card">
            <form id="smtpForm">
              <h3>Setup SMTP Credentials</h3>
              <div class="form-group">
                <input
                  type="text"
                  id="smtpHost"
                  placeholder="SMTP Host"
                  value="smtp.gmail.com"
                  readonly
                  aria-describedby="smtpHostError"
                />
                <div class="error-msg" id="smtpHostError" role="alert"></div>
              </div>
              <div class="form-group">
                <input
                  type="text"
                  id="smtpPort"
                  placeholder="Port"
                  value="465"
                  readonly
                  aria-describedby="smtpPortError"
                />
                <div class="error-msg" id="smtpPortError" role="alert"></div>
              </div>
              <div class="form-group">
                <input
                  type="email"
                  id="smtpUser"
                  placeholder="Your email"
                  autocomplete="email"
                  aria-describedby="smtpUserError"
                />
                <div class="error-msg" id="smtpUserError" role="alert"></div>
              </div>
              <div class="form-group">
                <input
                  type="password"
                  id="smtpPass"
                  placeholder="SMTP Password"
                  autocomplete="new-password"
                  aria-describedby="smtpPassError"
                />
                <button
                  type="button"
                  class="toggle-password"
                  onclick="togglePassword('smtpPass', this)"
                  aria-label="Toggle SMTP password visibility"
                >
                  👁
                </button>
                <div class="error-msg" id="smtpPassError" role="alert"></div>
              </div>
              <button type="submit" class="btn btn-primary btn-full">
                Save SMTP Credentials
              </button>
              <button
                type="button"
                class="btn btn-secondary btn-full hidden"
                id="cancelSMTPBtn"
              >
                Cancel Update
              </button>
              <p class="success-msg" id="smtpGetSuccess">
                SMTP loaded successfully!
              </p>
              <div class="error-msg" id="smtpFormApiError" role="alert"></div>
            </form>
            <div class="video-container active" id="smtpHelpVideo">
              <label>Setup SMTP password</label>
              <iframe
                src="https://www.youtube-nocookie.com/embed/ZfEK3WP73eY?si=BDXP_G0VaVZyaZGg"
                title="How to find SMTP credentials"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </section>

        <!-- Email History Section -->
        <!-- Insert this inside your Email History section (HTML part) -->
        <section
          id="emailHistorySection"
          class="section"
          aria-label="Email History"
          tabindex="-1"
          style="display: none"
        >
          <h2>Email History</h2>
          <div id="emailHistoryList" aria-live="polite"></div>

          <!-- Expanded Email Detail View, hidden by default -->
          <div
            id="emailDetailView"
            style="display: none; margin-top: 20px"
            aria-live="polite"
          >
            <button
              id="closeEmailDetailBtn"
              class="btn btn-secondary"
              style="float: right"
            >
              Close
            </button>
            <h4>Emails sent to <span id="detailRecipient"></span></h4>
            <div id="emailDetailContent" style="margin-top: 16px"></div>
          </div>
        </section>
      </main>
    </div>

    <!-- Password Modal (kept for backward compatibility, hidden by default) -->
    <div class="modal" id="passwordModal" aria-hidden="true">
      <div class="modal-content">
        <h3>Update Password</h3>
        <div class="form-group">
          <input
            type="password"
            id="modalNewPassword"
            minlength="6"
            autocomplete="new-password"
            placeholder="New password"
          />
          <button
            class="toggle-password"
            onclick="togglePassword('modalNewPassword', this)"
          >
            👁
          </button>
          <div class="error-msg" id="modalNewPasswordError"></div>
        </div>
        <div class="form-group">
          <input
            type="password"
            id="modalConfirmPassword"
            minlength="6"
            autocomplete="new-password"
            placeholder="Confirm password"
          />
          <button
            class="toggle-password"
            onclick="togglePassword('modalConfirmPassword', this)"
          >
            👁
          </button>
          <div class="error-msg" id="modalConfirmPasswordError"></div>
        </div>
        <div style="display: flex; gap: 10px">
          <button
            class="btn btn-secondary"
            onclick="closeModal('passwordModal')"
          >
            Cancel
          </button>
          <button class="btn btn-primary" id="modalUpdatePasswordBtn" disabled>
            Update
          </button>
        </div>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io();
      const authToken = localStorage.getItem('token') || '';
      const userNameFromStorage = localStorage.getItem('userName') || 'User';
      const userEmailFromStorage =
        localStorage.getItem('email') || 'user@example.com';

      // Elements
      const sidebar = document.getElementById('sidebarNav');
      const sidebarToggle = document.getElementById('sidebarToggle');
      const mainContent = document.getElementById('mainContent');
      const emailGeneratorBtn = document.getElementById('emailGeneratorBtn');
      const emailHistoryBtn = document.getElementById('emailHistoryBtn');
      const smtpHelpVideo = document.getElementById('smtpHelpVideo');

      // Email History section elements
      const emailHistorySection = document.getElementById(
        'emailHistorySection',
      );
      const emailHistoryList = document.getElementById('emailHistoryList');
      const emailDetailView = document.getElementById('emailDetailView');
      const emailDetailContent = document.getElementById('emailDetailContent');
      const detailRecipient = document.getElementById('detailRecipient');
      const closeEmailDetailBtn = document.getElementById(
        'closeEmailDetailBtn',
      );

      // Set user info in navbar and dashboard
      document.getElementById('userName').textContent = userNameFromStorage;
      document.getElementById('userEmail').textContent = userEmailFromStorage;
      document.getElementById('navUserName').textContent = userNameFromStorage;

      // Dark/Light Mode Toggle
      const modeToggle = document.getElementById('modeToggle');

      if (localStorage.getItem('mode') === 'dark') {
        document.body.classList.add('dark-mode');
        modeToggle.checked = true;
      }

      modeToggle.addEventListener('change', () => {
        if (modeToggle.checked) {
          document.body.classList.add('dark-mode');
          localStorage.setItem('mode', 'dark');
        } else {
          document.body.classList.remove('dark-mode');
          localStorage.setItem('mode', 'light');
        }
      });

      // Sidebar toggle for small screens
      sidebarToggle.addEventListener('click', () => {
        const expanded = sidebarToggle.getAttribute('aria-expanded') === 'true';
        sidebarToggle.setAttribute('aria-expanded', !expanded);
        sidebar.classList.toggle('open');
      });

      // Close sidebar on main content click (small screens)
      mainContent.addEventListener('click', () => {
        if (window.innerWidth <= 900 && sidebar.classList.contains('open')) {
          sidebar.classList.remove('open');
          sidebarToggle.setAttribute('aria-expanded', false);
        }
      });

      // Sidebar navigation logic with EMAIL HISTORY special handling
      const sidebarButtons = sidebar.querySelectorAll('button[data-target]');
      const sections = document.querySelectorAll('.section');

      sidebarButtons.forEach((btn) => {
        btn.addEventListener('click', async () => {
          // Remove active class from all buttons
          sidebarButtons.forEach((b) => b.classList.remove('active'));
          // Add active to clicked button
          btn.classList.add('active');

          // Hide all sections and email detail view
          sections.forEach((sec) => {
            sec.style.display = 'none';
            sec.classList.remove('active');
          });
          emailDetailView.style.display = 'none';
          emailHistoryList.innerHTML = '';

          // Show target section
          const targetId = btn.getAttribute('data-target');
          const targetSection = document.getElementById(targetId);
          if (targetSection) {
            targetSection.style.display = 'block';
            targetSection.classList.add('active');
            // Focus main content for accessibility if needed
            mainContent.focus();
          }

          // Show video only in SMTP Setup section
          if (targetId === 'smtpSetupSection') {
            smtpHelpVideo.classList.add('active');
          } else {
            smtpHelpVideo.classList.remove('active');
          }

          // Load email history only when Email History section is activated
          if (targetId === 'emailHistorySection') {
            await loadEmailHistory();
          }

          // Close sidebar on small screen after selection
          if (window.innerWidth <= 900) {
            sidebar.classList.remove('open');
            sidebarToggle.setAttribute('aria-expanded', false);
          }
        });
      });

      // Logout button in sidebar
      document.getElementById('logoutBtnSidebar').onclick = () => {
        localStorage.clear();
        window.location = '/login';
      };

      // Dashboard buttons to open Update Password and SMTP Setup sections
      document.getElementById('openPasswordModalSidebar').onclick = () => {
        document
          .querySelector('.sidebar button[data-target="updatePasswordSection"]')
          .click();
        clearPasswordInputs();
      };

      document.getElementById('openSMTPModalSidebar').onclick = () => {
        document
          .querySelector('.sidebar button[data-target="smtpSetupSection"]')
          .click();
        fetchSMTP();
      };

      // Password update section logic
      const newPasswordInput = document.getElementById('newPassword');
      const confirmPasswordInput = document.getElementById('confirmPassword');
      const updatePasswordBtn = document.getElementById('updatePasswordBtn');
      const passSuccessInline = document.getElementById('passSuccessInline');

      function clearPasswordErrors() {
        document.getElementById('newPasswordError').textContent = '';
        document.getElementById('confirmPasswordError').textContent = '';
      }

      function validatePasswords() {
        clearPasswordErrors();
        const n = newPasswordInput.value.trim();
        const c = confirmPasswordInput.value.trim();
        document.getElementById('newPasswordError').textContent =
          n.length < 6 ? 'Must be 6+ chars.' : '';
        document.getElementById('confirmPasswordError').textContent =
          c !== n ? 'Passwords do not match' : '';
        updatePasswordBtn.disabled = !(c === n && n.length >= 6);
      }

      newPasswordInput.oninput = validatePasswords;
      confirmPasswordInput.oninput = validatePasswords;

      updatePasswordBtn.onclick = async () => {
        const pwd = newPasswordInput.value.trim();
        try {
          const res = await axios.post(
            '/user/reset',
            { password: pwd },
            { headers: { Authorization: `Bearer ${authToken}` } },
          );
          if (res.data.success) {
            passSuccessInline.style.display = 'block';
            setTimeout(() => (passSuccessInline.style.display = 'none'), 3000);
            clearPasswordInputs();
          } else {
            document.getElementById('newPasswordError').textContent =
              res.data.message || 'Failed';
          }
        } catch (err) {
          document.getElementById('newPasswordError').textContent =
            err.response?.data?.message || 'Error updating password.';
        }
      };

      document.getElementById('cancelUpdatePasswordBtn').onclick = () => {
        clearPasswordInputs();
        document
          .querySelector('.sidebar button[data-target="dashboardSection"]')
          .click();
      };

      function clearPasswordInputs() {
        newPasswordInput.value = '';
        confirmPasswordInput.value = '';
        clearPasswordErrors();
        updatePasswordBtn.disabled = true;
      }

      // SMTP Setup form logic
      async function fetchSMTP() {
        document.getElementById('smtpApiError').textContent = '';
        try {
          const res = await axios.get('/user/smtp', {
            headers: { Authorization: `Bearer ${authToken}` },
          });
          if (res.data.valid) {
            if (res.data.smtp)
              document.getElementById('smtpUser').value =
                res.data.smtp.user || '';
            localStorage.setItem('smtp', 'true');
            document.getElementById('smtpGetSuccess').style.display = 'block';
            setTimeout(() => {
              document.getElementById('smtpGetSuccess').style.display = 'none';
            }, 3000);
            emailGeneratorBtn.style.display = 'inline-block';
            emailHistoryBtn.style.display = 'inline-block';
          } else {
            localStorage.removeItem('smtp');
            clearSMTPForm();
            emailGeneratorBtn.style.display = 'none';
            emailHistoryBtn.style.display = 'none';
            // Redirect if user is on email gen/history
            const activeBtn = document.querySelector('.sidebar button.active');
            if (
              activeBtn === emailGeneratorBtn ||
              activeBtn === emailHistoryBtn
            ) {
              document
                .querySelector(
                  '.sidebar button[data-target="dashboardSection"]',
                )
                .click();
            }
          }
        } catch (err) {
          document.getElementById('smtpApiError').textContent =
            err.response?.data?.message || 'Could not fetch SMTP info.';
          localStorage.removeItem('smtp');
          clearSMTPForm();
          emailGeneratorBtn.style.display = 'none';
          emailHistoryBtn.style.display = 'none';
          const activeBtn = document.querySelector('.sidebar button.active');
          if (
            activeBtn === emailGeneratorBtn ||
            activeBtn === emailHistoryBtn
          ) {
            document
              .querySelector('.sidebar button[data-target="dashboardSection"]')
              .click();
          }
        }
      }

      function clearSMTPForm() {
        document.getElementById('smtpUser').value = '';
        document.getElementById('smtpPass').value = '';
      }

      document.getElementById('cancelSMTPBtn').onclick = () => {
        document
          .querySelector('.sidebar button[data-target="dashboardSection"]')
          .click();
      };

      document.getElementById('smtpForm').onsubmit = async (e) => {
        e.preventDefault();
        [
          'smtpHostError',
          'smtpPortError',
          'smtpUserError',
          'smtpPassError',
          'smtpFormApiError',
        ].forEach((id) => (document.getElementById(id).textContent = ''));
        let ok = true,
          host = document.getElementById('smtpHost').value.trim(),
          port = document.getElementById('smtpPort').value.trim(),
          user = document.getElementById('smtpUser').value.trim(),
          pass = document.getElementById('smtpPass').value;
        if (!host) {
          document.getElementById('smtpHostError').textContent = 'Required';
          ok = false;
        }
        if (!port || isNaN(port)) {
          document.getElementById('smtpPortError').textContent = 'Valid port';
          ok = false;
        }
        if (!user) {
          document.getElementById('smtpUserError').textContent = 'Required';
          ok = false;
        }
        if (!pass) {
          document.getElementById('smtpPassError').textContent = 'Required';
          ok = false;
        }
        if (!ok) return;
        const btn = document.querySelector('#smtpForm button[type="submit"]');
        btn.disabled = true;
        try {
          const res = await axios.post(
            '/user/smtp',
            { host, port, user, pass },
            { headers: { Authorization: `Bearer ${authToken}` } },
          );
          if (res.data.success) {
            document.getElementById('smtpSuccess').style.display = 'block';
            localStorage.setItem('smtp', 'true');
            setTimeout(() => {
              document.getElementById('smtpSuccess').style.display = 'none';
            }, 3000);
            emailGeneratorBtn.style.display = 'inline-block';
            emailHistoryBtn.style.display = 'inline-block';
            document
              .querySelector('.sidebar button[data-target="dashboardSection"]')
              .click();
          } else {
            document.getElementById('smtpFormApiError').textContent =
              res.data.message || 'Failed to save SMTP.';
          }
        } catch (err) {
          document.getElementById('smtpFormApiError').textContent =
            err.response?.data?.message || 'Error saving SMTP credentials.';
        } finally {
          btn.disabled = false;
        }
      };

      // Gemini Email Generator using socket.io streaming
      function updateStatus(msg, isError) {
        const el = document.getElementById('sendError');
        el.textContent = msg;
        el.style.display = msg ? 'block' : 'none';
        el.style.color = isError ? '#e53935' : '#219653';
      }

      function generateEmail() {
        const topic = document.getElementById('topic').value.trim();
        const tone = document.getElementById('emailTone').value.trim();

        const subjectInput = document.getElementById('subject');
        const contentArea = document.getElementById('emailContent');
        const sendBtn = document.getElementById('sendEmailBtn');
        const generateBtn = document.getElementById('generateEmailBtn');

        if (!topic || !tone) {
          updateStatus('Please fill both topic and tone fields', true);
          return;
        }

        subjectInput.value = '';
        contentArea.value = '';
        sendBtn.disabled = true;
        generateBtn.disabled = true;
        generateBtn.innerHTML =
          '<i class="fas fa-spinner fa-spin"></i> Generating...';
        updateStatus('Generating email in real-time...');

        let cleanResponse = '';

        const onChunk = (chunk) => {
          const filteredChunk = chunk
            .replace(/json/g, '')
            .replace(/\\/g, '')
            .trim();
          cleanResponse += filteredChunk;
          contentArea.value = cleanResponse;
        };

        const onDone = (emailData) => {
          try {
            subjectInput.value = emailData.subject;
            contentArea.value = emailData.body;
            updateStatus('Email generated successfully!');
            showToast('Email generated successfully!', 3000, () => {
              sendBtn.disabled = false;
              generateBtn.disabled = false;
              generateBtn.innerHTML =
                '<i class="fas fa-magic"></i> Generate Email';
            });
          } catch (err) {
            console.error('Data handling error:', err);
            updateStatus(
              'Failed to process email response. Please try again.',
              true,
            );
            sendBtn.disabled = false;
            generateBtn.disabled = false;
            generateBtn.innerHTML =
              '<i class="fas fa-magic"></i> Generate Email';
          } finally {
            socket.off('email_chunk', onChunk);
            socket.off('email_done', onDone);
            socket.off('email_error', onError);
          }
        };

        const onError = (errMsg) => {
          updateStatus(errMsg || 'Failed to generate email', true);
          generateBtn.disabled = false;
          generateBtn.innerHTML = '<i class="fas fa-magic"></i> Generate Email';

          socket.off('email_chunk', onChunk);
          socket.off('email_done', onDone);
          socket.off('email_error', onError);
        };

        socket.on('email_chunk', onChunk);
        socket.on('email_done', onDone);
        socket.on('email_error', onError);

        socket.emit('generate_email', { topic, tone });
      }

      async function sendEmail() {
        ['topic', 'emailTone', 'toEmail', 'subject'].forEach(clearError);
        ['sendError', 'sendSuccess'].forEach((id) => {
          document.getElementById(id).textContent = '';
          document.getElementById(id).style.display = 'none';
        });

        const content = document.getElementById('emailContent').value.trim();
        const to = document.getElementById('toEmail').value.trim();
        const subject = document.getElementById('subject').value.trim();
        const files = document.getElementById('attachments').files;

        let valid = true;
        if (!content) {
          setError('topic', 'Email content is required.');
          valid = false;
        }
        if (!to) {
          setError('toEmail', 'Enter your email.');
          valid = false;
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(to)) {
          setError('toEmail', 'Invalid email format');
          valid = false;
        }
        if (!subject) {
          setError('subject', 'Enter a subject.');
          valid = false;
        }
        if (!valid) return;

        const btn = document.getElementById('sendEmailBtn');
        btn.disabled = true;
        btn.textContent = 'Sending...';

        // Use FormData for file uploads
        const formData = new FormData();
        formData.append('toEmail', to);
        formData.append('subject', subject);
        formData.append('content', content);
        for (let i = 0; i < files.length; i++) {
          formData.append('attachments', files[i]);
        }

        try {
          const res = await axios.post('/user/sendmail', formData, {
            headers: {
              Authorization: `Bearer ${authToken}`,
              'Content-Type': 'multipart/form-data',
            },
          });

          if (res.data.success) {
            showToast(
              res.data.message || 'Email sent successfully!',
              3000,
              () => {
                btn.disabled = false;
                btn.textContent = 'Send to My Email';
              },
            );
            ['topic', 'toEmail', 'subject'].forEach(
              (id) => (document.getElementById(id).value = ''),
            );
            document.getElementById('emailTone').selectedIndex = 0;
            document.getElementById('emailContent').value = '';
            document.getElementById('attachments').value = ''; // clear file input
            // Reload email history only if email history section active
            if (emailHistorySection.classList.contains('active')) {
              loadEmailHistory();
            }
          } else {
            document.getElementById('sendError').textContent =
              res.data.message || 'Failed to send email.';
            document.getElementById('sendError').style.display = 'block';
            btn.disabled = false;
            btn.textContent = 'Send to My Email';
          }
        } catch (err) {
          document.getElementById('sendError').textContent =
            err.response?.data?.message || 'Error sending email.';
          document.getElementById('sendError').style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Send to My Email';
        }
      }

      function setError(field, msg) {
        const id = (field === 'toEmail' ? 'toEmail' : field) + 'Error';
        document.getElementById(id).textContent = msg;
      }
      function clearError(field) {
        const id = (field === 'toEmail' ? 'toEmail' : field) + 'Error';
        document.getElementById(id).textContent = '';
      }

      // --- Email History Expand Logic ---

      // Render email detail view for a recipient
      function showEmailDetails(entry) {
        detailRecipient.textContent = entry.recipientEmail;
        emailDetailContent.innerHTML = '';

        entry.body.reverse();
        entry.subjects.reverse();
        // Render all subjects & bodies
        for (let i = 0; i < entry.subjects.length; i++) {
          const subj = entry.subjects[i];
          const body = entry.body && entry.body[i] ? entry.body[i] : '';
          const emailDiv = document.createElement('div');
          emailDiv.style.borderBottom = '1px solid #eee';
          emailDiv.style.padding = '12px 0';

          emailDiv.innerHTML = `
        <strong>Subject:</strong> ${subj}<br>
        <strong>Body:</strong>
        <pre style="white-space:pre-wrap;border-radius:6px;padding:8px;">${body}</pre>
      `;

          emailDetailContent.appendChild(emailDiv);
        }

        emailDetailView.style.display = 'block';
        emailDetailView.scrollIntoView({ behavior: 'smooth' });
      }

      closeEmailDetailBtn.onclick = () => {
        emailDetailView.style.display = 'none';
      };

      // Load email history only when user clicks sidebar Email History
      async function loadEmailHistory() {
        try {
          const res = await axios.get('/user/email-history', {
            headers: {
              Authorization: `Bearer ${authToken}`,
            },
          });

          emailHistoryList.innerHTML = '';
          emailDetailView.style.display = 'none';

          const data =
            res.data && Array.isArray(res.data.data) ? res.data.data : [];

          if (data.length === 0) {
            emailHistoryList.innerHTML = '<p>No emails sent yet.</p>';
            return;
          }

          // Show the total number of emails sent on top
          const totalCount = data.reduce(
            (sum, entry) => sum + (entry.count || 0),
            0,
          );
          const totalDiv = document.createElement('div');
          totalDiv.innerHTML = `<strong>Total Emails Sent:</strong> ${totalCount}`;
          totalDiv.style.marginBottom = '12px';
          emailHistoryList.appendChild(totalDiv);

          data.forEach((entry) => {
            const card = document.createElement('div');
            card.className = 'history-card';
            card.style.cursor = 'pointer';

            const subjects = Array.isArray(entry.subjects)
              ? entry.subjects.slice(-1).join(', ')
              : '';

            const date = entry.lastSentAt
              ? new Date(entry.lastSentAt).toLocaleString()
              : 'N/A';

            card.innerHTML = `
          <h4>${entry.recipientEmail}</h4>
          <p><strong>Sent:</strong> ${entry.count} time(s)</p>
          <p><strong>Recent Subjects:</strong> ${subjects || 'N/A'}</p>
          <p><strong>Last Sent:</strong> ${date}</p>
          <span style="color:#1976d2;font-size:0.98em;">Click to view all emails &rarr;</span>
        `;

            card.onclick = () => showEmailDetails(entry);

            emailHistoryList.appendChild(card);
          });
        } catch (err) {
          emailHistoryList.innerHTML =
            '<p style="color:red">Failed to load email history.</p>';
        }
      }

      // Toast notification with callback on hide
      function showToast(message, duration = 3000, onHide) {
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.textContent = message;
        document.body.appendChild(toast);

        setTimeout(() => toast.classList.add('show'), 100);

        setTimeout(() => {
          toast.classList.remove('show');
          setTimeout(() => {
            toast.remove();
            if (typeof onHide === 'function') onHide();
          }, 300);
        }, duration);
      }

      function togglePassword(id, btn) {
        const f = document.getElementById(id);
        f.type = f.type === 'password' ? 'text' : 'password';
        btn.textContent = f.type === 'password' ? '👁' : '🙈';
      }

      function closeModal(id) {
        document.getElementById(id).style.display = 'none';
      }

      // On page load, fetch SMTP only (no email history)
      window.addEventListener('DOMContentLoaded', () => {
        fetchSMTP();
        // Do NOT call loadEmailHistory here to avoid showing history on other pages.
      });
    </script>
  </body>
</html>
