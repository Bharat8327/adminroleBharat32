<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email History</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100 text-gray-800">
    <div class="max-w-5xl mx-auto p-6">
      <h1 class="text-3xl font-bold mb-6 text-center">📬 Your Email History</h1>

      <% if (emailHistory.length === 0) { %>
      <div class="text-center text-gray-500">No email history available.</div>
      <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% emailHistory.forEach(user => { %>
        <div class="bg-white shadow-md rounded-xl p-5">
          <h2 class="text-xl font-semibold text-blue-600 break-all">
            <%= user.recipientEmail %>
          </h2>
          <p class="mt-2 text-sm text-gray-500">
            Total Emails Sent:
            <span class="font-medium text-black"><%= user.count %></span>
          </p>
          <p class="text-sm text-gray-500 mb-2">
            Last Sent:
            <span class="font-medium text-black"
              ><%= new Date(user.lastSentAt).toLocaleString() %></span
            >
          </p>

          <h3 class="mt-3 text-sm text-gray-700 font-semibold">
            Subjects Sent:
          </h3>
          <ul class="list-disc ml-5 mt-1 text-sm text-gray-700">
            <% user.subjects.forEach(subject => { %>
            <li><%= subject %></li>
            <% }) %>
          </ul>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </body>
</html>
