<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Welcome | Auth System</title>
    <style>
      body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #6a11cb, #2575fc);
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        color: #fff;
      }

      .container {
        text-align: center;
        background: rgba(255, 255, 255, 0.1);
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
      }

      h1 {
        margin-bottom: 20px;
        font-size: 2.2rem;
      }

      .btn {
        display: inline-block;
        margin: 10px;
        padding: 12px 30px;
        border: none;
        background: #fff;
        color: #2575fc;
        font-size: 1rem;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        font-weight: bold;
        transition: background 0.3s, color 0.3s;
      }

      .btn:hover {
        background: #2575fc;
        color: #fff;
      }

      .tagline {
        font-size: 1rem;
        margin-top: 10px;
        color: #eee;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Welcome to the Auth System</h1>
      <p class="tagline">Please login or register to continue</p>
      <a class="btn" href="/login">Login</a>
      <a class="btn" href="/createaccount">Signup</a>
    </div>
  </body>
</html>
