<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome | Auth System</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #6a11cb, #2575fc);
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        color: #fff;
        padding: 20px;
      }

      .container {
        text-align: center;
        background: rgba(255, 255, 255, 0.1);
        padding: 40px 20px;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        width: 100%;
        max-width: 400px;
      }

      h1 {
        margin-bottom: 20px;
        font-size: 2rem;
      }

      .btn {
        display: inline-block;
        margin: 10px 5px;
        padding: 12px 24px;
        border: none;
        background: #fff;
        color: #2575fc;
        font-size: 1rem;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        font-weight: bold;
        transition: background 0.3s, color 0.3s;
        min-width: 100px;
      }

      .btn:hover {
        background: #2575fc;
        color: #fff;
      }

      .tagline {
        font-size: 1rem;
        margin-top: 10px;
        color: #eee;
      }

      /* Responsive adjustments for smaller screens */
      @media (max-width: 480px) {
        h1 {
          font-size: 1.5rem;
        }

        .btn {
          width: 100%;
          margin: 8px 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Welcome to the Auth System</h1>
      <p class="tagline">Please login or register to continue</p>
      <a class="btn" href="/login">Login</a>
      <a class="btn" href="/createaccount">Signup</a>
    </div>
  </body>
</html>
